# ─────────────────────────────────────────────────────────
# MOTS Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the .env file to version control.
# ─────────────────────────────────────────────────────────

# Google Gemini API key
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Neon PostgreSQL connection string
# Format: postgresql://user:password@host/dbname?sslmode=require
# Get yours at: https://neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/mots?sslmode=require

# Port the Express server listens on (Render sets this automatically)
PORT=3001

# Allowed CORS origin — your Vercel frontend URL
# Local dev: http://localhost:5500  or  http://127.0.0.1:5500
# Production: https://your-app.vercel.app
FRONTEND_ORIGIN=http://localhost:5500
