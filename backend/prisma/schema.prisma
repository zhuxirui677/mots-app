// This is your Prisma schema file.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon requires connection pooling for serverless environments.
  // Uncomment directUrl when using Prisma Migrate CLI directly against Neon:
  // directUrl = env("DIRECT_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum SessionStatus {
  pending  // Gemini generation in progress
  ready    // Letter + persona profile generated successfully
  error    // Generation failed; check error field
}

// ── Models ────────────────────────────────────────────────────────────────────

model Session {
  // Primary key — UUID generated by the backend, stored in browser sessionStorage.
  // No user accounts; the UUID is the only session identifier.
  id String @id @default(uuid()) @db.Uuid

  created_at DateTime @default(now())

  // Raw answers from the 5-step intake survey.
  // Shape: { name, nickname, pronouns, relationship, coreValue, emotionalWeather,
  //          thingsNeverSaid, chatSample }
  survey_inputs Json @db.JsonB

  // Structured persona profile produced by the first Gemini generateContent call.
  // Used as systemInstruction for startChat.
  // Shape: { speakingStyle, quirks, values, memories, tone, systemPrompt }
  persona_profile Json? @db.JsonB

  // The personal letter text returned by the first Gemini call.
  letter String?

  // Overall status of this session's AI generation job.
  status SessionStatus @default(pending)

  // Conversation turns between the user and the AI persona.
  // Array of { role: "user" | "model", parts: [{ text: string }] }
  // Mirrors Gemini's history format for easy replay.
  chat_history Json @default("[]") @db.JsonB

  // Human-readable error message if status === error.
  error_message String?

  @@map("sessions")
}

// ── Persona archetype templates ───────────────────────────────────────────────
// Seeded once at deploy time via prisma/seed.js.
// Matched by keyword against survey_inputs.relationship.

model PersonaTemplate {
  id             Int      @id @default(autoincrement())
  key            String   @unique          // e.g. "grandmother"
  labels         String[]                  // matching keywords (lowercase)
  archetype      String                    // 1–2 sentence role description
  speaking_style String                    // rhythm, formality, punctuation
  verbal_quirks  String                    // tics, phrases, sign-offs
  core_traits    String                    // values, personality essence
  memory_topics  String                    // typical shared experiences

  @@map("persona_templates")
}
